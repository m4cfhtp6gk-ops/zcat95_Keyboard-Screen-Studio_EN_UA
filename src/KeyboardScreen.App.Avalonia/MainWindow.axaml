<Window
    x:Class="KeyboardScreen.App.Avalonia.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KeyboardScreen.App.Avalonia.Controls"
    xmlns:infra="using:KeyboardScreen.App.Avalonia.Infrastructure"
    xmlns:vm="using:KeyboardScreen.App.Avalonia.ViewModels"
    Title="Keyboard Screen Studio"
    Width="1280"
    Height="800"
    MinWidth="1080"
    MinHeight="680"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="64"
    TransparencyLevelHint="Transparent"
    Background="Transparent">

  <Window.Resources>
    <infra:ConnectionBrushConverter x:Key="ConnectionBrushConverter" />
    <infra:ImageTimePlacementLabelConverter x:Key="ImageTimePlacementLabelConverter" />
    <infra:DotMatrixProgressPeriodLabelConverter x:Key="DotMatrixProgressPeriodLabelConverter" />
    <infra:ImageClockStyleLabelConverter x:Key="ImageClockStyleLabelConverter" />
    <infra:ImageTextColorLabelConverter x:Key="ImageTextColorLabelConverter" />
    <infra:ImageTextAlignmentLabelConverter x:Key="ImageTextAlignmentLabelConverter" />
    <infra:ImageDigitalOrderLabelConverter x:Key="ImageDigitalOrderLabelConverter" />
    <infra:ImageAnalogOrderLabelConverter x:Key="ImageAnalogOrderLabelConverter" />
    <infra:UiThemeModeLabelConverter x:Key="UiThemeModeLabelConverter" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="ListBox.order-picker"><Setter Property="Height" Value="144" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="SelectionMode" Value="Single" /></Style>
    <Style Selector="ListBox.order-picker ListBoxItem"><Setter Property="MinHeight" Value="0" /><Setter Property="Margin" Value="4" /><Setter Property="Padding" Value="14,0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Background" Value="{DynamicResource KssControlBrush}" /><Setter Property="Foreground" Value="{DynamicResource KssForegroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource KssControlBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /></Style>
    <Style Selector="ListBox.order-picker ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource KssControlHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource KssControlFocusBrush}" /></Style>
    <Style Selector="ListBox.order-picker ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource KssSelectedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource KssControlFocusBrush}" /><Setter Property="Foreground" Value="{DynamicResource KssForegroundBrush}" /></Style>    <Style Selector="NumericUpDown.compact-value"><Setter Property="Width" Value="72" /><Setter Property="Height" Value="40" /><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="8,0" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="CornerRadius" Value="12" /></Style>
    <Style Selector="TextBox.segment">
      <Setter Property="Height" Value="48" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ScrollViewer
              x:Name="PART_ScrollViewer"
              HorizontalScrollBarVisibility="Hidden"
              VerticalScrollBarVisibility="Hidden">
            <TextPresenter
                x:Name="PART_TextPresenter"
                Margin="{TemplateBinding Padding}"
                Text="{TemplateBinding Text, Mode=TwoWay}"
                CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                CaretIndex="{TemplateBinding CaretIndex}"
                SelectionStart="{TemplateBinding SelectionStart}"
                SelectionEnd="{TemplateBinding SelectionEnd}"
                TextAlignment="{TemplateBinding TextAlignment}"
                TextWrapping="{TemplateBinding TextWrapping}"
                PasswordChar="{TemplateBinding PasswordChar}"
                RevealPassword="{TemplateBinding RevealPassword}"
                SelectionBrush="{TemplateBinding SelectionBrush}"
                SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                CaretBrush="{TemplateBinding CaretBrush}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ScrollViewer>
        </ControlTemplate>
      </Setter>    </Style>
    <Style Selector="TextBox.segment:focus">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.embedded">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,0,10,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ScrollViewer
              x:Name="PART_ScrollViewer"
              HorizontalScrollBarVisibility="Hidden"
              VerticalScrollBarVisibility="Hidden">
            <TextPresenter
                x:Name="PART_TextPresenter"
                Margin="{TemplateBinding Padding}"
                Text="{TemplateBinding Text, Mode=TwoWay}"
                CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                CaretIndex="{TemplateBinding CaretIndex}"
                SelectionStart="{TemplateBinding SelectionStart}"
                SelectionEnd="{TemplateBinding SelectionEnd}"
                TextAlignment="{TemplateBinding TextAlignment}"
                TextWrapping="{TemplateBinding TextWrapping}"
                PasswordChar="{TemplateBinding PasswordChar}"
                RevealPassword="{TemplateBinding RevealPassword}"
                SelectionBrush="{TemplateBinding SelectionBrush}"
                SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                CaretBrush="{TemplateBinding CaretBrush}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ScrollViewer>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TextBox.embedded:focus">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>  </Window.Styles>

  <Border
      Background="{DynamicResource KssWindowSurfaceBrush}"
      BorderBrush="{DynamicResource KssWindowBorderBrush}"
      BorderThickness="1"
      CornerRadius="{DynamicResource KssWindowCornerRadius}"
      ClipToBounds="True">
    <Grid RowDefinitions="64,*">
      <Grid
          x:Name="TitleBar"
          Grid.Row="0"
          ColumnDefinitions="*,Auto"
          Background="Transparent"
          PointerPressed="TitleBar_OnPointerPressed">
        <TextBlock
            Margin="22,0,0,0"
            VerticalAlignment="Center"
            FontSize="14"
            FontWeight="SemiBold"
            Text="Keyboard Screen Studio" />
        <StackPanel
            Grid.Column="1"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Orientation="Horizontal">
          <Button Classes="titlebar" Click="ThemeModeButton_OnClick" ToolTip.Tip="{infra:Localize TitleBarThemeToggle}">
            <TextBlock VerticalAlignment="Center" FontSize="18" Foreground="{DynamicResource KssForegroundBrush}" Text="◐" />
          </Button>
          <Button Classes="titlebar" Click="MinimizeButton_OnClick">
            <Border Width="12" Height="1" Background="{DynamicResource KssForegroundBrush}" />
          </Button>
          <Button Classes="titlebar" Click="MaximizeButton_OnClick">
            <Border Width="10" Height="10" BorderBrush="{DynamicResource KssForegroundBrush}" BorderThickness="1.2" />
          </Button>
          <Button Classes="titlebar close" Click="CloseButton_OnClick">
            <Canvas Width="12" Height="12">
              <Border Canvas.Top="5.5" Width="12" Height="1" Background="{DynamicResource KssForegroundBrush}" RenderTransform="rotate(45deg)" RenderTransformOrigin="50%,50%" />
              <Border Canvas.Top="5.5" Width="12" Height="1" Background="{DynamicResource KssForegroundBrush}" RenderTransform="rotate(-45deg)" RenderTransformOrigin="50%,50%" />
            </Canvas>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="22,0,22,22" ColumnDefinitions="280,16,*">
        <Grid Grid.Column="0" Margin="0,10,0,0" RowDefinitions="Auto,*,Auto">
          <StackPanel>
            <TextBlock FontSize="25" FontWeight="SemiBold" Text="{infra:Localize AppHeading}" />
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="8">
              <Ellipse
                  Width="8"
                  Height="8"
                  VerticalAlignment="Center"
                  Fill="{Binding DeviceConnected, Converter={StaticResource ConnectionBrushConverter}}" />
              <TextBlock
                  VerticalAlignment="Center"
                  Classes="secondary"
                  Foreground="{Binding DeviceConnected, Converter={StaticResource ConnectionBrushConverter}}"
                  Text="{Binding DeviceStatus}" />
            </StackPanel>
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,24,0,0" RowDefinitions="Auto,*">
            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{infra:Localize SidebarThemesHeading}" />
            <ScrollViewer
                Classes="edge-fade"
                Grid.Row="1"
                Margin="0,12,-6,0"
                Padding="0,0,6,0"
                VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding ThemeGroups}" x:CompileBindings="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock
                          Margin="0,10,0,8"
                          FontSize="11"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource KssSecondaryBrush}"
                          Text="{Binding Name}" />
                      <ItemsControl ItemsSource="{Binding Themes}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button
                                Classes="sidebar"
                                Classes.selected="{Binding IsSelected}"
                                Command="{Binding $parent[Window].DataContext.SelectThemeCommand}"
                                CommandParameter="{Binding Id}"
                                Content="{Binding Name}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <Border Grid.Row="2" Margin="0,16,0,0" Classes="card sidebar-surface" Padding="14">
            <StackPanel Spacing="5">
              <TextBlock Classes="secondary" FontSize="11" Text="{infra:Localize DeviceAddress}" />
              <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding DeviceSummary}" />
            </StackPanel>
          </Border>
        </Grid>

        <Border
            Grid.Column="2"
            Margin="0,10,0,0"
            Padding="28,22"
            Classes="elevated"
            CornerRadius="{DynamicResource KssCornerRadius}">
          <Grid RowDefinitions="64,*">
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
              <Button Classes="nav" Classes.selected="{Binding IsScreenPage}" Command="{Binding SelectNavigationCommand}" CommandParameter="screen" Content="{infra:Localize NavScreen}" />
              <Button Classes="nav" Classes.selected="{Binding IsThemePage}" Command="{Binding SelectNavigationCommand}" CommandParameter="theme" Content="{infra:Localize NavTheme}" />
              <Button Classes="nav" Classes.selected="{Binding IsAutomationPage}" Command="{Binding SelectNavigationCommand}" CommandParameter="automation" Content="{infra:Localize NavAutomation}" />
              <Button Classes="nav" Classes.selected="{Binding IsSettingsPage}" Command="{Binding SelectNavigationCommand}" CommandParameter="settings" Content="{infra:Localize NavSettings}" />
              <Button Classes="nav" Classes.selected="{Binding IsAboutPage}" Command="{Binding SelectNavigationCommand}" CommandParameter="about" Content="{infra:Localize NavAbout}" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,24,272">
              <ScrollViewer Grid.Column="0" Classes="edge-fade" VerticalScrollBarVisibility="Auto">
                <Grid>
                  <StackPanel x:Name="ScreenPage" Classes="page-content" IsVisible="{Binding IsScreenPage}" Spacing="16">
                    <Border Classes="card">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="secondary" Text="{infra:Localize ScreenCurrentTheme}" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding CurrentThemeName}" />
                        <TextBlock Classes="secondary" Text="{Binding CurrentThemeDescription}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Classes="card">
                      <StackPanel Spacing="9">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{infra:Localize ScreenContentHeading}" />
                        <TextBlock Classes="secondary" Text="{Binding CurrentThemeDetails}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Classes="card">
                      <StackPanel Spacing="9">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{infra:Localize ScreenCurrentData}" />
                        <TextBlock Classes="secondary" Text="{Binding SourceSummary}" TextWrapping="Wrap" />
                        <TextBlock Classes="secondary" Text="{Binding LastUpdated}" />
                      </StackPanel>
                    </Border>
                    <Button
                        IsVisible="{Binding IsImageTheme}"
                        HorizontalAlignment="Left"
                        Click="ChooseImageButton_OnClick"
                        Content="{infra:Localize ScreenChooseImage}" />
                  </StackPanel>

                  <StackPanel x:Name="ThemePage" Classes="page-content" IsVisible="{Binding IsThemePage}" Spacing="16" x:CompileBindings="False">
                    <Border Classes="card">
                      <StackPanel Spacing="16">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize ScreenFontHeading}" />
                        <Grid ColumnDefinitions="*,12,Auto">
                          <ComboBox
                              Grid.Column="0"
                              ItemsSource="{Binding Fonts}"
                              SelectedValue="{Binding SelectedFontId, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Id}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="2,0" ColumnDefinitions="*,Auto">
                                  <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                  <TextBlock
                                      Grid.Column="1"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      Classes="secondary"
                                      FontSize="10"
                                      IsVisible="{Binding !IsBuiltIn}"
                                      Text="{Binding FileName}" />
                                </Grid>
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <Button Grid.Column="2" Command="{Binding OpenFontsFolderCommand}" Content="{infra:Localize ScreenOpenFontsFolder}" />
                        </Grid>
                      </StackPanel>
                    </Border>

                                        <Grid ColumnDefinitions="*,16,*">
                      <Border Grid.Column="0" Grid.ColumnSpan="{Binding ThemeAccentColumnSpan}" Height="126" Classes="card">
                        <StackPanel Spacing="16">
                          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize ScreenAccentHeading}" />
                          <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,12,96">
                            <Border Grid.Column="0" Height="44" Classes="inline">
                              <Grid ColumnDefinitions="44,*">
                                <Border Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{Binding AccentColor}" BorderBrush="{DynamicResource KssControlBorderBrush}"
                                        BorderThickness="1" CornerRadius="12" />
                                <TextBox Grid.Column="1" Classes="embedded" Height="42" MinWidth="0" Padding="6,0,10,0"
                                         Text="{Binding AccentColor, Mode=TwoWay}" TextAlignment="Center" />
                              </Grid>
                            </Border>
                            <Button Grid.Column="2" HorizontalAlignment="Stretch" Padding="8,0"
                                    Click="AccentColorButton_OnClick" Content="{infra:Localize ScreenChooseColor}" />
                          </Grid>
                        </StackPanel>
                      </Border>

                      <Border Grid.Column="2" Height="126" Classes="card" IsVisible="{Binding IsImageTheme}">
                        <StackPanel Spacing="16">
                          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize ImageTimePlacementHeading}" />
                          <ComboBox ItemsSource="{Binding ImageTimePlacements}" SelectedItem="{Binding ImageTimePlacement, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ImageTimePlacementLabelConverter}}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                      </Border>

                      <Border Grid.Column="2" Height="126" Classes="card" IsVisible="{Binding IsDotMatrixProgressTheme}">
                        <StackPanel Spacing="16">
                          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize ProgressPeriodHeading}" />
                          <ComboBox ItemsSource="{Binding DotMatrixProgressPeriods}" SelectedItem="{Binding DotMatrixProgressPeriod, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource DotMatrixProgressPeriodLabelConverter}}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                      </Border>
                    </Grid>

                    <Border IsVisible="{Binding IsDotMatrixProgressTheme}" Classes="card">
                      <StackPanel Spacing="16">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize TopInfoHeading}" />
                        <Grid ColumnDefinitions="78,*,72" ColumnSpacing="12">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize FontSizeLabel}" />
                          <Slider Grid.Column="1" Minimum="12" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DotMatrixProgressHeaderFontSize, Mode=TwoWay}" />
                          <NumericUpDown Grid.Column="2" Classes="compact-value" Minimum="12" Maximum="20" Increment="1" FormatString="0" ShowButtonSpinner="False" Value="{Binding DotMatrixProgressHeaderFontSize, Mode=TwoWay}" />
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsImageTheme}" Classes="card">
                      <StackPanel Spacing="16">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize ImageClockHeading}" />
                        <Grid ColumnDefinitions="*,16,*">
                          <StackPanel Spacing="7">
                            <TextBlock Classes="secondary" Text="{infra:Localize ClockStyleLabel}" />
                            <ComboBox ItemsSource="{Binding ImageClockStyles}" SelectedItem="{Binding ImageClockStyle, Mode=TwoWay}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Converter={StaticResource ImageClockStyleLabelConverter}}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="7">
                            <TextBlock Classes="secondary" Text="{infra:Localize TextColorLabel}" />
                            <ComboBox ItemsSource="{Binding ImageTextColors}" SelectedItem="{Binding ImageTextColor, Mode=TwoWay}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Converter={StaticResource ImageTextColorLabelConverter}}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,16,*">
                          <StackPanel Spacing="7">
                            <TextBlock Classes="secondary" Text="{infra:Localize TextAlignmentLabel}" />
                            <ComboBox IsEnabled="{Binding IsImageTextAlignmentEnabled}" ItemsSource="{Binding ImageTextAlignments}" SelectedItem="{Binding ImageTextAlignment, Mode=TwoWay}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Converter={StaticResource ImageTextAlignmentLabelConverter}}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                          <Grid Grid.Column="2" ColumnDefinitions="*,Auto" RowDefinitions="44,44">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{infra:Localize TimeBackgroundLabel}" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ImageTimeBackground, Mode=TwoWay}" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{infra:Localize ShowWeatherLabel}" />
                            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding ImageWeatherVisible, Mode=TwoWay}" />
                          </Grid>
                        </Grid>

                        <StackPanel IsVisible="{Binding IsImageDigitalClockStyle}" Spacing="12">
                          <TextBlock Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold" Text="{infra:Localize DigitalLayoutHeading}" />
                          <Grid ColumnDefinitions="100,*" ColumnSpacing="12"><TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize ContentOrderLabel}" /><ListBox Grid.Column="1" Classes="order-picker" ItemsSource="{Binding ImageDigitalOrders}" SelectedItem="{Binding ImageDigitalOrder, Mode=TwoWay}"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><TextBlock VerticalAlignment="Center" Text="{Binding Converter={StaticResource ImageDigitalOrderLabelConverter}}" /></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
                          <Grid ColumnDefinitions="78,*,72" ColumnSpacing="12"><TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize TimeSizeLabel}" /><Slider Grid.Column="1" Minimum="20" Maximum="38" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ImageTimeFontSize, Mode=TwoWay}" /><NumericUpDown Grid.Column="2" Classes="compact-value" Minimum="20" Maximum="38" Increment="1" FormatString="0" ShowButtonSpinner="False" Value="{Binding ImageTimeFontSize, Mode=TwoWay}" /></Grid>
                          <Grid ColumnDefinitions="78,*,72" ColumnSpacing="12"><TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize DateSizeLabel}" /><Slider Grid.Column="1" Minimum="9" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ImageDateFontSize, Mode=TwoWay}" /><NumericUpDown Grid.Column="2" Classes="compact-value" Minimum="9" Maximum="18" Increment="1" FormatString="0" ShowButtonSpinner="False" Value="{Binding ImageDateFontSize, Mode=TwoWay}" /></Grid>
                          <Grid IsVisible="{Binding ImageWeatherVisible}" ColumnDefinitions="78,*,72" ColumnSpacing="12"><TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize WeatherSizeLabel}" /><Slider Grid.Column="1" Minimum="9" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ImageWeatherFontSize, Mode=TwoWay}" /><NumericUpDown Grid.Column="2" Classes="compact-value" Minimum="9" Maximum="18" Increment="1" FormatString="0" ShowButtonSpinner="False" Value="{Binding ImageWeatherFontSize, Mode=TwoWay}" /></Grid>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsImageLargeDigitalClockStyle}" Spacing="12">
                          <TextBlock Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold" Text="{infra:Localize LargeDigitalLayoutHeading}" />
                          <Grid ColumnDefinitions="100,*" ColumnSpacing="12"><TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize ContentOrderLabel}" /><ListBox Grid.Column="1" Classes="order-picker" ItemsSource="{Binding ImageDigitalOrders}" SelectedItem="{Binding ImageDigitalOrder, Mode=TwoWay}"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><TextBlock VerticalAlignment="Center" Text="{Binding Converter={StaticResource ImageDigitalOrderLabelConverter}}" /></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
                          <Grid ColumnDefinitions="78,*,72" ColumnSpacing="12"><TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize TimeSizeLabel}" /><Slider Grid.Column="1" Minimum="32" Maximum="44" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ImageLargeTimeFontSize, Mode=TwoWay}" /><NumericUpDown Grid.Column="2" Classes="compact-value" Minimum="32" Maximum="44" Increment="1" FormatString="0" ShowButtonSpinner="False" Value="{Binding ImageLargeTimeFontSize, Mode=TwoWay}" /></Grid>
                          <Grid ColumnDefinitions="78,*,72" ColumnSpacing="12"><TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize DateSizeLabel}" /><Slider Grid.Column="1" Minimum="9" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ImageDateFontSize, Mode=TwoWay}" /><NumericUpDown Grid.Column="2" Classes="compact-value" Minimum="9" Maximum="18" Increment="1" FormatString="0" ShowButtonSpinner="False" Value="{Binding ImageDateFontSize, Mode=TwoWay}" /></Grid>
                          <Grid IsVisible="{Binding ImageWeatherVisible}" ColumnDefinitions="78,*,72" ColumnSpacing="12"><TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize WeatherSizeLabel}" /><Slider Grid.Column="1" Minimum="9" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ImageWeatherFontSize, Mode=TwoWay}" /><NumericUpDown Grid.Column="2" Classes="compact-value" Minimum="9" Maximum="18" Increment="1" FormatString="0" ShowButtonSpinner="False" Value="{Binding ImageWeatherFontSize, Mode=TwoWay}" /></Grid>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsImageAnalogClockStyle}" Spacing="12">
                          <TextBlock Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold" Text="{infra:Localize AnalogLayoutHeading}" />
                          <Grid ColumnDefinitions="100,*" ColumnSpacing="12"><TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize ContentOrderLabel}" /><ListBox Grid.Column="1" Classes="order-picker" ItemsSource="{Binding ImageAnalogOrders}" SelectedItem="{Binding ImageAnalogOrder, Mode=TwoWay}"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><TextBlock VerticalAlignment="Center" Text="{Binding Converter={StaticResource ImageAnalogOrderLabelConverter}}" /></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
                          <Grid ColumnDefinitions="78,*,72" ColumnSpacing="12"><TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize ClockSizeLabel}" /><Slider Grid.Column="1" Minimum="58" Maximum="104" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ImageAnalogClockSize, Mode=TwoWay}" /><NumericUpDown Grid.Column="2" Classes="compact-value" Minimum="58" Maximum="104" Increment="1" FormatString="0" ShowButtonSpinner="False" Value="{Binding ImageAnalogClockSize, Mode=TwoWay}" /></Grid>
                          <Grid ColumnDefinitions="78,*,72" ColumnSpacing="12"><TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize DateSizeLabel}" /><Slider Grid.Column="1" Minimum="9" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ImageDateFontSize, Mode=TwoWay}" /><NumericUpDown Grid.Column="2" Classes="compact-value" Minimum="9" Maximum="18" Increment="1" FormatString="0" ShowButtonSpinner="False" Value="{Binding ImageDateFontSize, Mode=TwoWay}" /></Grid>
                          <Grid IsVisible="{Binding ImageWeatherVisible}" ColumnDefinitions="78,*,72" ColumnSpacing="12"><TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize WeatherSizeLabel}" /><Slider Grid.Column="1" Minimum="9" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ImageWeatherFontSize, Mode=TwoWay}" /><NumericUpDown Grid.Column="2" Classes="compact-value" Minimum="9" Maximum="18" Increment="1" FormatString="0" ShowButtonSpinner="False" Value="{Binding ImageWeatherFontSize, Mode=TwoWay}" /></Grid>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsImageFlipClockStyle}" Spacing="12">
                          <TextBlock Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold" Text="{infra:Localize FlipLayoutHeading}" />
                          <Grid ColumnDefinitions="78,*,72" ColumnSpacing="12"><TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize TimeSizeLabel}" /><Slider Grid.Column="1" Minimum="20" Maximum="38" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ImageFlipTimeFontSize, Mode=TwoWay}" /><NumericUpDown Grid.Column="2" Classes="compact-value" Minimum="20" Maximum="38" Increment="1" FormatString="0" ShowButtonSpinner="False" Value="{Binding ImageFlipTimeFontSize, Mode=TwoWay}" /></Grid>
                          <Grid ColumnDefinitions="78,*,72" ColumnSpacing="12"><TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize DateSizeLabel}" /><Slider Grid.Column="1" Minimum="9" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ImageDateFontSize, Mode=TwoWay}" /><NumericUpDown Grid.Column="2" Classes="compact-value" Minimum="9" Maximum="18" Increment="1" FormatString="0" ShowButtonSpinner="False" Value="{Binding ImageDateFontSize, Mode=TwoWay}" /></Grid>
                          <Grid IsVisible="{Binding ImageWeatherVisible}" ColumnDefinitions="78,*,72" ColumnSpacing="12"><TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize WeatherSizeLabel}" /><Slider Grid.Column="1" Minimum="9" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ImageWeatherFontSize, Mode=TwoWay}" /><NumericUpDown Grid.Column="2" Classes="compact-value" Minimum="9" Maximum="18" Increment="1" FormatString="0" ShowButtonSpinner="False" Value="{Binding ImageWeatherFontSize, Mode=TwoWay}" /></Grid>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsWeatherSettingsVisible}" Classes="card">
                      <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="6">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize WeatherHeading}" />
                            <TextBlock Classes="secondary" Text="{infra:Localize WeatherAutoLocationHint}" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" IsChecked="{Binding WeatherAutomaticLocation, Mode=TwoWay}" Content="{infra:Localize WeatherAutoLocation}" />
                        </Grid>
                        <Grid ColumnDefinitions="92,*">
                          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{infra:Localize WeatherCityLabel}" />
                          <TextBox
                              Grid.Column="1"
                              IsEnabled="{Binding IsManualWeatherLocationEnabled}"
                              Text="{Binding WeatherLocation, Mode=TwoWay}" />
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsPerformanceVisualTheme}" Classes="card">
                      <StackPanel Spacing="12">
                        <StackPanel Spacing="6">
                          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize PerfVisualHeading}" />
                          <TextBlock Classes="secondary" Text="{infra:Localize PerfVisualHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="CPU" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding PerfVisualCpuEnabled, Mode=TwoWay}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{infra:Localize LabelMemory}" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding PerfVisualMemoryEnabled, Mode=TwoWay}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{infra:Localize LabelDownload}" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding PerfVisualDownloadEnabled, Mode=TwoWay}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{infra:Localize LabelUpload}" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding PerfVisualUploadEnabled, Mode=TwoWay}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="GPU" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding PerfVisualGpuEnabled, Mode=TwoWay}" /></Grid>
                      </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsClaudeTheme}" Classes="card">
                      <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="6">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize ClaudeHeading}" />
                            <TextBlock Classes="secondary" Text="{infra:Localize ClaudeSessionKeyHint}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Grid.Column="1" VerticalAlignment="Top" Command="{Binding OpenClaudeSiteCommand}" Content="{infra:Localize ClaudeOpenSite}" />
                        </Grid>
                        <StackPanel Spacing="10">
                          <TextBlock FontWeight="SemiBold" Text="{infra:Localize ClaudeGuideHeading}" />
                          <Grid RowDefinitions="Auto,10,Auto,10,Auto" ColumnDefinitions="32,*">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource KssSelectedBrush}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="1" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="{infra:Localize ClaudeGuideStep1}" /><TextBlock Classes="secondary" Text="{infra:Localize ClaudeGuideStep1Hint}" /></StackPanel>
                            <Border Grid.Row="2" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource KssSelectedBrush}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="2" /></Border>
                            <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="{infra:Localize ClaudeGuideStep2}" /><TextBlock Classes="secondary" Text="{infra:Localize ClaudeGuideStep2Hint}" TextWrapping="Wrap" /></StackPanel>
                            <Border Grid.Row="4" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource KssSelectedBrush}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="3" /></Border>
                            <StackPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="{infra:Localize ClaudeGuideStep3}" /><TextBlock Classes="secondary" Text="{infra:Localize ClaudeGuideStep3Hint}" /></StackPanel>
                          </Grid>
                        </StackPanel>
                        <StackPanel Spacing="6">
                          <TextBlock Classes="secondary" Text="{infra:Localize ClaudeSessionKeyLabel}" />
                          <TextBox PasswordChar="*"
                                   PlaceholderText="{infra:Localize ClaudeSessionKeyPlaceholder}"
                                   Text="{Binding ClaudeSessionKey, Mode=TwoWay}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                          <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Classes="secondary" Text="{infra:Localize ClaudeModelScopeLabel}" />
                          </StackPanel>
                          <TextBox Grid.Column="1" MaxLength="24" Text="{Binding ClaudeModelScope, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Classes="secondary" FontSize="11" Text="{infra:Localize ClaudeModelScopeHint}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="5">
                            <TextBlock FontWeight="SemiBold" Text="{infra:Localize ClaudeCountTokensLabel}" />
                            <TextBlock Classes="secondary" FontSize="11" Text="{infra:Localize ClaudeCountTokensHint}" TextWrapping="Wrap" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ClaudeCountLocalTokens, Mode=TwoWay}" />
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsStockTheme}" Classes="card">
                      <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize ThemeStocksName}" />
                          <TextBlock
                              Classes="secondary"
                              Text="{infra:Localize StocksHint}"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnDefinitions="24,150,10,120,Auto">
                          <TextBlock Grid.Column="1" Classes="secondary" Text="{infra:Localize StocksSymbolLabel}" />
                          <TextBlock Grid.Column="3" Classes="secondary" Text="{infra:Localize StocksAliasLabel}" />
                          <TextBlock Grid.Column="4" Margin="16,0,0,0" Classes="secondary" Text="{infra:Localize StocksShowLabel}" />
                        </Grid>

                        <Grid ColumnDefinitions="24,150,10,120,Auto">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="1" />
                          <TextBox Grid.Column="1" MaxLength="24" PlaceholderText="AAPL" Text="{Binding StockSymbol1, Mode=TwoWay}" />
                          <TextBox Grid.Column="3" MaxLength="12" PlaceholderText="Apple" Text="{Binding StockAlias1, Mode=TwoWay}" />
                          <ToggleSwitch Grid.Column="4" HorizontalAlignment="Left" Margin="16,0,0,0" MinWidth="58" OnContent="" OffContent="" IsEnabled="{Binding StockSlot1CanDisable}" IsChecked="{Binding StockEnabled1, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="24,150,10,120,Auto">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="2" />
                          <TextBox Grid.Column="1" MaxLength="24" PlaceholderText="0700.HK" Text="{Binding StockSymbol2, Mode=TwoWay}" />
                          <TextBox Grid.Column="3" MaxLength="12" PlaceholderText="{infra:Localize StocksAliasPlaceholder2}" Text="{Binding StockAlias2, Mode=TwoWay}" />
                          <ToggleSwitch Grid.Column="4" HorizontalAlignment="Left" Margin="16,0,0,0" MinWidth="58" OnContent="" OffContent="" IsEnabled="{Binding StockSlot2CanDisable}" IsChecked="{Binding StockEnabled2, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="24,150,10,120,Auto">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="3" />
                          <TextBox Grid.Column="1" MaxLength="24" PlaceholderText="BTC-USD" Text="{Binding StockSymbol3, Mode=TwoWay}" />
                          <TextBox Grid.Column="3" MaxLength="12" PlaceholderText="Bitcoin" Text="{Binding StockAlias3, Mode=TwoWay}" />
                          <ToggleSwitch Grid.Column="4" HorizontalAlignment="Left" Margin="16,0,0,0" MinWidth="58" OnContent="" OffContent="" IsEnabled="{Binding StockSlot3CanDisable}" IsChecked="{Binding StockEnabled3, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="24,150,10,120,Auto">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="4" />
                          <TextBox Grid.Column="1" MaxLength="24" PlaceholderText="600519.SS" Text="{Binding StockSymbol4, Mode=TwoWay}" />
                          <TextBox Grid.Column="3" MaxLength="12" PlaceholderText="{infra:Localize StocksAliasPlaceholder4}" Text="{Binding StockAlias4, Mode=TwoWay}" />
                          <ToggleSwitch Grid.Column="4" HorizontalAlignment="Left" Margin="16,0,0,0" MinWidth="58" OnContent="" OffContent="" IsEnabled="{Binding StockSlot4CanDisable}" IsChecked="{Binding StockEnabled4, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="24,150,10,120,Auto">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="5" />
                          <TextBox Grid.Column="1" MaxLength="24" PlaceholderText="000001.SZ" Text="{Binding StockSymbol5, Mode=TwoWay}" />
                          <TextBox Grid.Column="3" MaxLength="12" PlaceholderText="{infra:Localize StocksAliasPlaceholder5}" Text="{Binding StockAlias5, Mode=TwoWay}" />
                          <ToggleSwitch Grid.Column="4" HorizontalAlignment="Left" Margin="16,0,0,0" MinWidth="58" OnContent="" OffContent="" IsEnabled="{Binding StockSlot5CanDisable}" IsChecked="{Binding StockEnabled5, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,220">
                          <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="{infra:Localize StocksColorLabel}" />
                            <TextBlock Classes="secondary" Text="{infra:Localize StocksCacheNote}" />
                          </StackPanel>
                          <ComboBox
                              Grid.Column="1"
                              ItemsSource="{Binding StockColorPreferences}"
                              SelectedItem="{Binding StockColorPreference, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,220">
                          <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="{infra:Localize StocksSourceLabel}" />
                            <TextBlock Classes="secondary" Text="{infra:Localize StocksSourceHint}" />
                          </StackPanel>
                          <ComboBox
                              Grid.Column="1"
                              ItemsSource="{Binding StockSourceOptions}"
                              SelectedItem="{Binding StockSourcePreference, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Classes="secondary" Text="{Binding SourceSummary}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsGitHubTheme}" Classes="card">
                      <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize GitHubHeading}" />
                          <TextBlock Classes="secondary" Text="{infra:Localize GitHubHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnDefinitions="170,*" ColumnSpacing="12">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize GitHubUsernameLabel}" />
                          <TextBox Grid.Column="1" MaxLength="39" PlaceholderText="octocat" Text="{Binding GitHubUsername, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="170,*" ColumnSpacing="12">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize GitHubTokenLabel}" />
                          <TextBox Grid.Column="1" PasswordChar="*" Text="{Binding GitHubToken, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Classes="secondary" Text="{Binding SourceSummary}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsHardwareTheme}" Classes="card">
                      <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize HardwareHeading}" />
                          <TextBlock Classes="secondary" Text="{infra:Localize HardwareHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnDefinitions="150,*,72" ColumnSpacing="12">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize HardwarePageSecondsLabel}" />
                          <Slider Grid.Column="1" Minimum="3" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding HardwarePageSeconds, Mode=TwoWay}" />
                          <NumericUpDown Grid.Column="2" Classes="compact-value" Minimum="3" Maximum="10" Increment="1" FormatString="0" ShowButtonSpinner="False" Value="{Binding HardwarePageSeconds, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Classes="secondary" Text="{Binding SourceSummary}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsCurrencyTheme}" Classes="card">
                      <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize CurrencyHeading}" />
                          <TextBlock Classes="secondary" Text="{infra:Localize CurrencyHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize CurrencyBaseLabel}" />
                          <TextBox Grid.Column="1" MaxLength="3" Text="{Binding CurrencyBase, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize CurrencyQuotesLabel}" />
                          <TextBox Grid.Column="1" MaxLength="64" Text="{Binding CurrencyQuotes, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Classes="secondary" FontSize="11" Text="{infra:Localize CurrencyQuotesHint}" TextWrapping="Wrap" />
                        <TextBlock Classes="secondary" Text="{Binding SourceSummary}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsCryptoTheme}" Classes="card">
                      <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize CryptoHeading}" />
                          <TextBlock Classes="secondary" Text="{infra:Localize CryptoHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnDefinitions="24,180">
                          <TextBlock Grid.Column="1" Classes="secondary" Text="{infra:Localize CryptoPairLabel}" />
                        </Grid>
                        <Grid ColumnDefinitions="24,180">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="1" />
                          <TextBox Grid.Column="1" MaxLength="20" PlaceholderText="BTCUSDT" Text="{Binding CryptoSymbol1, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="24,180">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="2" />
                          <TextBox Grid.Column="1" MaxLength="20" PlaceholderText="ETHUSDT" Text="{Binding CryptoSymbol2, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="24,180">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="3" />
                          <TextBox Grid.Column="1" MaxLength="20" PlaceholderText="SOLUSDT" Text="{Binding CryptoSymbol3, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="24,180">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="4" />
                          <TextBox Grid.Column="1" MaxLength="20" PlaceholderText="TONUSDT" Text="{Binding CryptoSymbol4, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,220">
                          <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="{infra:Localize StocksColorLabel}" />
                            <TextBlock Classes="secondary" Text="{infra:Localize StocksCacheNote}" />
                          </StackPanel>
                          <ComboBox
                              Grid.Column="1"
                              ItemsSource="{Binding StockColorPreferences}"
                              SelectedItem="{Binding CryptoColorPreference, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Classes="secondary" Text="{Binding SourceSummary}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsPomodoroTheme}" Classes="card">
                      <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize PomodoroHeading}" />
                          <TextBlock Classes="secondary" Text="{infra:Localize PomodoroHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnDefinitions="170,72" ColumnSpacing="12">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize PomodoroFocusLabel}" />
                          <NumericUpDown Grid.Column="1" Classes="compact-value" Minimum="1" Maximum="180" Increment="5" FormatString="0" ShowButtonSpinner="False" Value="{Binding PomodoroFocusMinutes, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="170,72" ColumnSpacing="12">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize PomodoroBreakLabel}" />
                          <NumericUpDown Grid.Column="1" Classes="compact-value" Minimum="1" Maximum="60" Increment="1" FormatString="0" ShowButtonSpinner="False" Value="{Binding PomodoroBreakMinutes, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="170,72" ColumnSpacing="12">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize PomodoroCyclesLabel}" />
                          <NumericUpDown Grid.Column="1" Classes="compact-value" Minimum="1" Maximum="12" Increment="1" FormatString="0" ShowButtonSpinner="False" Value="{Binding PomodoroTargetCycles, Mode=TwoWay}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <Button Command="{Binding StartPomodoroCommand}" IsEnabled="{Binding !IsPomodoroRunning}" Content="{infra:Localize PomodoroStart}" />
                          <Button Command="{Binding StopPomodoroCommand}" IsEnabled="{Binding IsPomodoroRunning}" Content="{infra:Localize PomodoroStop}" />
                        </StackPanel>
                        <TextBlock Classes="secondary" Text="{Binding SourceSummary}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsAiTheme}" Classes="card">
                      <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto,12,Auto">
                          <StackPanel Spacing="5">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize TokscaleHeading}" />
                            <TextBlock Classes="secondary" Text="{Binding TokscaleStatusTitle}" />
                          </StackPanel>
                          <Button Grid.Column="1" Command="{Binding OpenTokscaleDocsCommand}" Content="{infra:Localize TokscaleInstallDocs}" />
                          <Button Grid.Column="3" Command="{Binding RefreshTokscaleCommand}" Content="{infra:Localize TokscaleRecheck}" />
                        </Grid>

                        <Border Background="{DynamicResource KssControlBrush}" BorderBrush="{DynamicResource KssControlBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                          <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="{infra:Localize TokscaleLocalOnly}" />
                            <TextBlock Classes="secondary" Text="{infra:Localize TokscaleLocalOnlyHint}" TextWrapping="Wrap" />
                            <TextBlock Classes="secondary" Text="{Binding TokscaleStatusMessage}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>

                        <StackPanel IsVisible="{Binding IsTokscaleUnavailable}" Spacing="12">
                          <TextBlock FontWeight="SemiBold" Text="{infra:Localize TokscaleThreeSteps}" />
                          <Grid RowDefinitions="Auto,10,Auto,10,Auto" ColumnDefinitions="32,*">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource KssSelectedBrush}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="1" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="{infra:Localize TokscaleStep1}" /><TextBlock Classes="secondary" Text="{infra:Localize TokscaleStep1Hint}" /></StackPanel>
                            <Border Grid.Row="2" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource KssSelectedBrush}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="2" /></Border>
                            <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="{infra:Localize TokscaleStep2}" /><TextBlock Classes="secondary" Text="{infra:Localize TokscaleStep2Hint}" /></StackPanel>
                            <Border Grid.Row="4" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource KssSelectedBrush}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="3" /></Border>
                            <StackPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="{infra:Localize TokscaleStep3}" /><TextBlock Classes="secondary" Text="{infra:Localize TokscaleStep3Hint}" /></StackPanel>
                          </Grid>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsTokscaleReady}" Spacing="14">
                          <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Spacing="7">
                              <TextBlock Classes="secondary" Text="{infra:Localize AiMetricLabel}" />
                              <ComboBox ItemsSource="{Binding AiUsageModes}" SelectedItem="{Binding SelectedAiUsageMode, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                              </ComboBox>
                              <TextBlock Classes="secondary" FontSize="11" Text="{Binding SelectedAiUsageMode.Description}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="7">
                              <TextBlock Classes="secondary" Text="{infra:Localize AiDataItemLabel}" />
                              <ComboBox ItemsSource="{Binding TokscaleOptions}" SelectedItem="{Binding SelectedTokscaleOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                              </ComboBox>
                              <TextBlock Classes="secondary" FontSize="11" Text="{infra:Localize AiDataItemHint}" />
                            </StackPanel>
                          </Grid>

                          <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Spacing="7">
                              <TextBlock Classes="secondary" Text="{infra:Localize AiDisplayNameLabel}" />
                              <TextBox MaxLength="18" PlaceholderText="{infra:Localize AiDisplayNamePlaceholder}" Text="{Binding AiDisplayName, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" IsVisible="{Binding IsAiProgressTargetVisible}" Spacing="7">
                              <TextBlock Classes="secondary" Text="{infra:Localize AiGoalLabel}" />
                              <NumericUpDown Minimum="0" Maximum="1000000000000" Increment="1000" FormatString="0.##" ShowButtonSpinner="False" Value="{Binding AiProgressTarget, Mode=TwoWay}" />
                              <TextBlock Classes="secondary" FontSize="11" Text="{infra:Localize AiGoalHint}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <StackPanel x:Name="AutomationPage" Classes="page-content" IsVisible="{Binding IsAutomationPage}" Spacing="16">
                    <Border Classes="card">
                      <Grid RowDefinitions="Auto,8,Auto">
                        <StackPanel Spacing="4">
                          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize RefreshHeading}" />
                          <TextBlock Classes="secondary" Text="{infra:Localize RefreshHint}" />
                        </StackPanel>
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox Width="72" Text="{Binding RefreshSecondsInput, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{Binding RefreshDurationText}" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AutoPush, Mode=TwoWay}" Content="{infra:Localize AutoPushToggle}" />
                        </Grid>
                      </Grid>
                    </Border>

                    <Border Classes="card">
                      <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="7">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize MediaSwitchHeading}" />
                            <TextBlock Classes="secondary" Text="{infra:Localize MediaSwitchHint}" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoMediaThemeSwitch, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,16,*">
                          <StackPanel Spacing="8">
                            <TextBlock Classes="secondary" Text="{infra:Localize MediaIdleLabel}" />
                            <ComboBox IsEnabled="{Binding AutoMediaThemeSwitch}" ItemsSource="{Binding IdleThemeOptions}" SelectedValue="{Binding MediaIdleThemeId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="8">
                            <TextBlock Classes="secondary" Text="{infra:Localize MediaPlayingLabel}" />
                            <ComboBox IsEnabled="{Binding AutoMediaThemeSwitch}" ItemsSource="{Binding MusicThemeOptions}" SelectedValue="{Binding MediaPlayingThemeId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock FontWeight="SemiBold" Text="{infra:Localize IgnoreBrowserMedia}" /><TextBlock Classes="secondary" FontSize="11" Text="{infra:Localize IgnoreBrowserMediaHint}" TextWrapping="Wrap" /></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding IgnoreBrowserMediaSessions, Mode=TwoWay}" /></Grid>
                      </StackPanel>
                    </Border>

                    <Border Classes="card">
                      <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="7">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize ScheduleHeading}" />
                            <TextBlock Classes="secondary" Text="{infra:Localize ScheduleHint}" TextWrapping="Wrap" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ScheduleEnabled, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,16,*">
                          <StackPanel Spacing="8">
                            <TextBlock Classes="secondary" Text="{infra:Localize ScheduleNightStartLabel}" />
                            <TextBox IsEnabled="{Binding ScheduleEnabled}" MaxLength="5" Text="{Binding ScheduleNightStart, Mode=TwoWay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="8">
                            <TextBlock Classes="secondary" Text="{infra:Localize ScheduleNightEndLabel}" />
                            <TextBox IsEnabled="{Binding ScheduleEnabled}" MaxLength="5" Text="{Binding ScheduleNightEnd, Mode=TwoWay}" />
                          </StackPanel>
                        </Grid>
                        <TextBlock Classes="secondary" FontSize="11" Text="{infra:Localize ScheduleTimeHint}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{infra:Localize ScheduleSwitchThemeLabel}" />
                          <ToggleSwitch Grid.Column="1" IsEnabled="{Binding ScheduleEnabled}" IsChecked="{Binding ScheduleSwitchTheme, Mode=TwoWay}" />
                        </Grid>
                        <StackPanel Spacing="8">
                          <TextBlock Classes="secondary" Text="{infra:Localize ScheduleNightThemeLabel}" />
                          <ComboBox IsEnabled="{Binding ScheduleSwitchTheme}" ItemsSource="{Binding IdleThemeOptions}" SelectedValue="{Binding ScheduleNightThemeId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{infra:Localize ScheduleDimLabel}" />
                          <ToggleSwitch Grid.Column="1" IsEnabled="{Binding ScheduleEnabled}" IsChecked="{Binding ScheduleDimAtNight, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="130,*,72" ColumnSpacing="12">
                          <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{infra:Localize ScheduleBrightnessLabel}" />
                          <Slider Grid.Column="1" IsEnabled="{Binding ScheduleDimAtNight}" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding ScheduleNightBrightness, Mode=TwoWay}" />
                          <NumericUpDown Grid.Column="2" Classes="compact-value" IsEnabled="{Binding ScheduleDimAtNight}" Minimum="20" Maximum="100" Increment="5" FormatString="0" ShowButtonSpinner="False" Value="{Binding ScheduleNightBrightness, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Classes="secondary" FontSize="11" Text="{infra:Localize ScheduleMediaNote}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsMusicTheme}" Classes="card">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="7">
                          <TextBlock FontSize="15" FontWeight="SemiBold" Text="{infra:Localize AutoSwitchMusicHeading}" />
                          <TextBlock Classes="secondary" Text="{infra:Localize AutoSwitchMusicHint}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoSwitchToMusic, Mode=TwoWay}" />
                      </Grid>
                    </Border>
                  </StackPanel>

                  <StackPanel x:Name="SettingsPage" Classes="page-content" IsVisible="{Binding IsSettingsPage}" Spacing="16">
                    <Border Classes="card" Padding="16">
                      <Grid ColumnDefinitions="92,*">
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{infra:Localize LanguageHeading}" />
                        <ComboBox Grid.Column="1" x:CompileBindings="False"
                                  ItemsSource="{Binding AppLanguages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding NativeName}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
                    </Border>
                                        <Border Classes="card" Padding="16">
                      <Grid ColumnDefinitions="92,*">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                          <TextBlock FontSize="15" FontWeight="SemiBold" Text="{infra:Localize AppearanceHeading}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding UiThemeModes}" SelectedItem="{Binding UiThemeMode, Mode=TwoWay}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Converter={StaticResource UiThemeModeLabelConverter}}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
                    </Border>
<Border Classes="card" Padding="16">
                      <Grid ColumnDefinitions="92,*">
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{infra:Localize DeviceAddress}" />
                        <controls:IpAddressEditor Grid.Column="1" Value="{Binding DeviceIp, Mode=TwoWay}" />
                      </Grid>
                    </Border>

                    <Border Classes="card" Padding="16">
                      <StackPanel Spacing="10">
                        <StackPanel Spacing="4">
                          <TextBlock FontSize="15" FontWeight="SemiBold" Text="{infra:Localize DiagnosticsHeading}" />
                          <TextBlock Classes="secondary" FontSize="11" Text="{infra:Localize DiagnosticsHint}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,6,Auto" >
                          <TextBlock Classes="secondary" Text="{infra:Localize DiagnosticsLastPush}" />
                          <TextBlock Grid.Column="1" Text="{Binding DiagnosticsLastPushText}" />
                          <TextBlock Grid.Row="2" Classes="secondary" Text="{infra:Localize DiagnosticsRecentErrors}" />
                          <TextBlock Grid.Row="2" Grid.Column="1" Classes="secondary" Text="{Binding DiagnosticsErrorsText}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Classes="secondary" FontSize="11" Text="{Binding DiagnosticsDetailText}" />
                      </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="16">
                      <Grid ColumnDefinitions="92,*">
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{infra:Localize SafeAreaHeading}" />
                        <Border Grid.Column="1" Height="50" Classes="inline" ClipToBounds="True">
                          <Grid ColumnDefinitions="*,1,*,1,*,1,*">
                            <Grid>
                              <Grid ColumnDefinitions="28,*">
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Classes="secondary" FontSize="11" Text="{infra:Localize InsetLeft}" />
                                <TextBox Grid.Column="1" Classes="segment" BorderBrush="Transparent" BorderThickness="0" Background="Transparent" Text="{Binding SafeLeft, Mode=TwoWay}" />
                              </Grid>
                            </Grid>
                            <Border Grid.Column="1" Margin="0,12" Background="{DynamicResource KssDividerBrush}" />
                            <Grid Grid.Column="2" ColumnDefinitions="28,*">
                              <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Classes="secondary" FontSize="11" Text="{infra:Localize InsetTop}" />
                              <TextBox Grid.Column="1" Classes="segment" BorderBrush="Transparent" BorderThickness="0" Background="Transparent" Text="{Binding SafeTop, Mode=TwoWay}" />
                            </Grid>
                            <Border Grid.Column="3" Margin="0,12" Background="{DynamicResource KssDividerBrush}" />
                            <Grid Grid.Column="4" ColumnDefinitions="28,*">
                              <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Classes="secondary" FontSize="11" Text="{infra:Localize InsetRight}" />
                              <TextBox Grid.Column="1" Classes="segment" BorderBrush="Transparent" BorderThickness="0" Background="Transparent" Text="{Binding SafeRight, Mode=TwoWay}" />
                            </Grid>
                            <Border Grid.Column="5" Margin="0,12" Background="{DynamicResource KssDividerBrush}" />
                            <Grid Grid.Column="6" ColumnDefinitions="28,*">
                              <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Classes="secondary" FontSize="11" Text="{infra:Localize InsetBottom}" />
                              <TextBox Grid.Column="1" Classes="segment" BorderBrush="Transparent" BorderThickness="0" Background="Transparent" Text="{Binding SafeBottom, Mode=TwoWay}" />
                            </Grid>
                          </Grid>
                        </Border>
                      </Grid>
                    </Border>

                    <Border Classes="card">
                      <Grid RowDefinitions="32,14,32,14,32,14,32" ColumnDefinitions="*,Auto">
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{infra:Localize MinimizeToTray}" />
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{infra:Localize CloseToTray}" />
                        <ToggleSwitch Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{infra:Localize LaunchAtStartup}" />
                        <ToggleSwitch Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" />
                        <TextBlock Grid.Row="6" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{infra:Localize StartMinimized}" />
                        <ToggleSwitch Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                      </Grid>
                    </Border>
                  </StackPanel>

                  <StackPanel x:Name="AboutPage" Classes="page-content" IsVisible="{Binding IsAboutPage}" Spacing="16">
                    <Border Classes="card">
                      <StackPanel Spacing="8">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{infra:Localize NavAbout}" />
                        <TextBlock Classes="secondary" Text="{Binding AppVersionLabel}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <Button Content="{infra:Localize AboutCheckUpdates}" Command="{Binding CheckForUpdatesCommand}" />
                          <Button Content="{infra:Localize AboutOpenDownload}" Command="{Binding OpenLatestReleaseCommand}" IsVisible="{Binding IsUpdateAvailable}" />
                          <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{Binding UpdateStatusText}" />
                        </StackPanel>
                        <TextBlock
                            Classes="secondary"
                            Text="{infra:Localize AboutLicenseNote}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Classes="secondary"
                            Text="{infra:Localize AboutFontNote}"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Classes="card">
                      <StackPanel Spacing="12">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize AboutOpenSourceHeading}" />
                        <Grid ColumnDefinitions="1.7*,1.2*,2*">
                          <TextBlock FontWeight="SemiBold" Text="Avalonia UI 12" />
                          <TextBlock Grid.Column="1" Classes="secondary" Text="MIT License" />
                          <TextBlock Grid.Column="2" Classes="secondary" Text="Copyright © The AvaloniaUI Project" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource KssDividerBrush}" />
                        <Grid ColumnDefinitions="1.7*,1.2*,2*">
                          <TextBlock FontWeight="SemiBold" Text="SkiaSharp" />
                          <TextBlock Grid.Column="1" Classes="secondary" Text="MIT License" />
                          <TextBlock Grid.Column="2" Classes="secondary" Text="Copyright © Microsoft Corporation" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource KssDividerBrush}" />
                        <Grid ColumnDefinitions="1.7*,1.2*,2*">
                          <TextBlock FontWeight="SemiBold" Text="Doto" />
                          <TextBlock Grid.Column="1" Classes="secondary" Text="SIL OFL 1.1" />
                          <TextBlock Grid.Column="2" Classes="secondary" Text="Copyright © 2024 The Doto Project Authors" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource KssDividerBrush}" />
                        <Grid ColumnDefinitions="1.7*,1.2*,2*">
                          <TextBlock FontWeight="SemiBold" Text="MiSans" />
                          <TextBlock Grid.Column="1" Classes="secondary" Text="{infra:Localize AboutMiSansLicense}" />
                          <TextBlock Grid.Column="2" Classes="secondary" Text="{infra:Localize AboutXiaomiCopyright}" />
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Classes="card">
                      <StackPanel Spacing="8">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{infra:Localize AboutDataSourcesHeading}" />
                        <TextBlock
                            Classes="secondary"
                            Text="{infra:Localize AboutDataSourcesNote}"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <StackPanel Margin="0,2,0,6" HorizontalAlignment="Center" Spacing="2">
                      <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding AppVersion, StringFormat='Keyboard Screen Studio {0}'}" />
                      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Classes="secondary" Text="by " />
                        <Button
                            MinHeight="24"
                            Padding="2,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding OpenAuthorCommand}"
                            Content="ZCat95" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </ScrollViewer>

              <Border Grid.Column="2" Classes="card" Padding="24">
                <Grid RowDefinitions="Auto,24,*">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Text="{infra:Localize PreviewHeading}" />
                  <Border
                      Grid.Row="2"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Padding="8"
                      Background="#D4D9DE"
                      CornerRadius="32">
                    <Border
                        Width="142"
                        Height="428"
                        Background="#080B0F"
                        CornerRadius="24"
                        ClipToBounds="True">
                      <Grid>
                        <Image Source="{Binding PreviewImage}" Stretch="Fill" />

                        <!-- Firmware status overlays are preview-only occlusion guides. -->
                        <Border Width="36" Height="36" Margin="7,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#F6060A10" CornerRadius="18" />
                        <Border Width="77" Height="36" Margin="0,5,7,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#F6060A10" CornerRadius="18" />
                      </Grid>
                    </Border>
                  </Border>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
