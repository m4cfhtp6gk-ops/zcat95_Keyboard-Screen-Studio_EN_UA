<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\KeyboardScreen.App\Assets\AppIcon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.0.2</Version>
    <Authors>ZCat95</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KeyboardScreen.AvaloniaSmokeTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeyboardScreen.Core\KeyboardScreen.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="..\KeyboardScreen.App\Assets\TrayIcon.ico" Link="Assets\TrayIcon.ico" />
    <AvaloniaResource Include="..\KeyboardScreen.App\Assets\TrayIcon.White.ico" Link="Assets\TrayIcon.White.ico" />
    <Content Include="..\KeyboardScreen.App\Assets\AppIcon.ico" Link="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\KeyboardScreen.App\Assets\AppIcon.png" Link="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\KeyboardScreen.App\Assets\TrayIcon.ico" Link="Assets\TrayIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\KeyboardScreen.App\Assets\TrayIcon.White.ico" Link="Assets\TrayIcon.White.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\PRIVACY.md" Link="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\ASSET_LICENSE.md" Link="ASSET_LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Licenses\**" Link="Licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
