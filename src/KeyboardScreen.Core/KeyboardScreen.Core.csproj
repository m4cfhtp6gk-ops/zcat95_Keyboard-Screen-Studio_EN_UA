<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net8.0-windows10.0.19041.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Platform\Windows\**" />
    <Compile Include="Platform\Windows\**" Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'" />
  </ItemGroup>
  <ItemGroup>
    <!-- WithCulture=false is required: the .en / .uk / .zh-Hans infix otherwise
         reads as a culture tag and MSBuild ships these in satellite assemblies
         instead of embedding them in the main one. -->
    <EmbeddedResource Include="Localization/Strings.en.json" LogicalName="KeyboardScreen.Core.Localization.Strings.en.json" WithCulture="false" />
    <EmbeddedResource Include="Localization/Strings.uk.json" LogicalName="KeyboardScreen.Core.Localization.Strings.uk.json" WithCulture="false" />
    <EmbeddedResource Include="Localization/Strings.zh-Hans.json" LogicalName="KeyboardScreen.Core.Localization.Strings.zh-Hans.json" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The smoke tests exercise the parsing helpers directly; they stay
         internal so they are not part of the app's supported surface. -->
    <InternalsVisibleTo Include="KeyboardScreen.SmokeTests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Fonts\Doto.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="Assets\Fonts\Doto-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\MiSans-Medium.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="Assets\Fonts\MiSans-LICENSE.pdf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'" />
  </ItemGroup>
</Project>
