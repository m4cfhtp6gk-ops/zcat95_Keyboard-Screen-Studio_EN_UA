<Window x:Class="KeyboardScreen.App.MiMoTokenPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录 Xiaomi MiMo"
        Icon="pack://application:,,,/KeyboardScreen.App;component/Assets/AppIcon.png"
        Width="1040" Height="760" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource Surface.Control}" FontFamily="{StaticResource UiFontFamily}"
        Closing="Window_OnClosing">
    <Border x:Name="DialogRoot" Background="{StaticResource Surface.Control}" BorderBrush="{StaticResource Stroke.Default}"
            BorderThickness="1" CornerRadius="{StaticResource Radius.Window}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Xiaomi MiMo Token Plan" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="China · 登录状态仅保存在本机" FontSize="11" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="关闭" Style="{StaticResource CompactSecondaryButton}"
                        Margin="0,0,18,0" VerticalAlignment="Center" Click="CloseButton_OnClick" />
            </Grid>
            <Border Grid.Row="1" Margin="18,0,18,14" Style="{StaticResource InlineSurface}" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="请在下方登录小米账号，进入 Token Plan 页面后读取用量。"
                               FontSize="12" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="读取当前用量" MinWidth="126" Click="RefreshButton_OnClick" />
                </Grid>
            </Border>
            <Border Grid.Row="2" Margin="18,0,18,18" CornerRadius="{StaticResource Radius.Card}" ClipToBounds="True"
                    BorderBrush="{StaticResource Stroke.Default}" BorderThickness="1" Background="White">
                <wv2:WebView2 x:Name="Browser" />
            </Border>
        </Grid>
    </Border>
</Window>