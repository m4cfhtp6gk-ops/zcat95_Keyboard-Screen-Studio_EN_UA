<Window x:Class="KeyboardScreen.App.AccentColorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择主题强调色"
        Icon="pack://application:,,,/KeyboardScreen.App;component/Assets/AppIcon.png"
        Width="388" Height="470" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="Window_OnKeyDown">
    <Border x:Name="DialogRoot" Background="#FFFAFBFD"
            BorderBrush="{StaticResource Stroke.Default}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Window}"
            Padding="18" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="184" />
                <RowDefinition Height="24" />
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown" Margin="2,-2,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="选择主题强调色" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="拖动色域与色相条选择颜色" FontSize="11" Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="×" FontSize="16" Width="36" Height="36" MinWidth="36" MinHeight="36"
                        Style="{StaticResource WhiteDialogButton}" Padding="0" Click="CancelButton_OnClick" />
            </Grid>

            <Grid x:Name="ColorField" Grid.Row="1" Margin="0,12,0,0"
                  Cursor="Cross"
                  MouseLeftButtonDown="ColorField_OnMouseLeftButtonDown"
                  MouseMove="ColorField_OnMouseMove"
                  MouseLeftButtonUp="ColorField_OnMouseLeftButtonUp">
                <Border x:Name="ColorSurface" CornerRadius="{StaticResource Radius.Control}" ClipToBounds="True"
                        BorderBrush="{StaticResource Stroke.Default}" BorderThickness="1">
                    <Grid>
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="White" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="Black" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="ColorPointer" Width="20" Height="20"
                             Fill="Transparent" Stroke="White" StrokeThickness="4">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.55" Color="#70000000" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <Grid x:Name="HueField" Grid.Row="2" Margin="0,8,0,0"
                  Cursor="Hand"
                  MouseLeftButtonDown="HueField_OnMouseLeftButtonDown"
                  MouseMove="HueField_OnMouseMove"
                  MouseLeftButtonUp="HueField_OnMouseLeftButtonUp">
                <Border Height="16" CornerRadius="8" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF0000" Offset="0" />
                            <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                            <GradientStop Color="#FF00FF00" Offset="0.3333" />
                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                            <GradientStop Color="#FF0000FF" Offset="0.6667" />
                            <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                            <GradientStop Color="#FFFF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="HuePointer" Width="18" Height="18"
                             Stroke="White" StrokeThickness="4">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.45" Color="#70000000" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <Border x:Name="CurrentColorBar" Grid.Row="3" CornerRadius="{StaticResource Radius.Small}" Margin="0,10,0,0"
                    BorderBrush="{StaticResource Stroke.Default}" BorderThickness="1" />

            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Hex" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,4" />
                    <TextBox x:Name="HexTextBox" MaxLength="7" FontWeight="SemiBold"
                             Height="40" MinHeight="40" Padding="6,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextAlignment="Center" TextChanged="HexTextBox_OnTextChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="R" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,4" />
                    <TextBox x:Name="RedTextBox" MaxLength="3" Height="40" MinHeight="40" Padding="6,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextAlignment="Center"
                             TextChanged="RgbTextBox_OnTextChanged" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="G" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,4" />
                    <TextBox x:Name="GreenTextBox" MaxLength="3" Height="40" MinHeight="40" Padding="6,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextAlignment="Center"
                             TextChanged="RgbTextBox_OnTextChanged" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="B" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,4" />
                    <TextBox x:Name="BlueTextBox" MaxLength="3" Height="40" MinHeight="40" Padding="6,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextAlignment="Center"
                             TextChanged="RgbTextBox_OnTextChanged" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="5" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="取消" Style="{StaticResource WhiteDialogButton}"
                        MinWidth="84" MinHeight="40" Height="40" Click="CancelButton_OnClick" />
                <Button Grid.Column="3" Content="应用颜色" Style="{StaticResource WhiteDialogButton}" MinWidth="108" MinHeight="40" Height="40" Click="ApplyButton_OnClick" />
            </Grid>
        </Grid>
    </Border>
</Window>