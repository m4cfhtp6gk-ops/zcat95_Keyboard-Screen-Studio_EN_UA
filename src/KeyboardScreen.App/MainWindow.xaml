<Window x:Class="KeyboardScreen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:KeyboardScreen.App"
        Title="Keyboard Screen Studio"
        Icon="pack://application:,,,/KeyboardScreen.App;component/Assets/AppIcon.png"
        Width="1280" Height="800" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False"
        Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="-1" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowRoot" Background="Transparent" CornerRadius="{StaticResource Radius.Window}" BorderBrush="Transparent" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <TextBlock Text="Keyboard Screen Studio" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButton}" ToolTip="最小化" Click="MinimizeButton_OnClick">
                        <Path Width="12" Height="12" Data="M 1,6 L 11,6" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                    </Button>
                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButton}" ToolTip="最大化或还原" Click="MaximizeButton_OnClick">
                        <Grid Width="12" Height="12">
                            <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Rectangle Width="8" Height="8" Margin="0,3,3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" />
                                <Rectangle Width="8" Height="8" Margin="3,0,0,3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource CloseTitleBarButton}" ToolTip="关闭" Click="CloseButton_OnClick">
                        <Path Width="12" Height="12" Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="22,0,22,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="键盘显示屏" FontSize="25" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Ellipse x:Name="DeviceStatusDot" Width="8" Height="8" Fill="#9AA0AA" Margin="0,0,8,0" />
                            <TextBlock x:Name="DeviceStatusText" Text="断开连接" FontSize="12" Foreground="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </StackPanel>


                    <Grid Grid.Row="1" Margin="0,24,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="显示方案" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-6,0" Padding="0,0,6,0" IsDeferredScrollingEnabled="False" local:SmoothScrollBehavior.IsEnabled="True">
                            <StackPanel x:Name="ThemeListPanel" />
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Row="2" Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="14" Margin="0,16,17,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="设备地址" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                                <TextBlock x:Name="EndpointSummaryText" Text="地址未配置" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Background="{StaticResource Surface.Window}" CornerRadius="{StaticResource Radius.Window}" Margin="0,10,0,0" Padding="28,22">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ScreenNav" GroupName="Navigation" Content="屏幕配置" Style="{StaticResource NavRadio}" Tag="screen" Checked="Navigation_OnChecked" IsChecked="True" />
                            <RadioButton x:Name="ThemeNav" GroupName="Navigation" Content="主题设置" Style="{StaticResource NavRadio}" Tag="theme" Checked="Navigation_OnChecked" />
                            <RadioButton x:Name="AutomationNav" GroupName="Navigation" Content="自动化" Style="{StaticResource NavRadio}" Tag="automation" Checked="Navigation_OnChecked" />
                            <RadioButton x:Name="SettingsNav" GroupName="Navigation" Content="其他设置" Style="{StaticResource NavRadio}" Tag="settings" Checked="Navigation_OnChecked" />
                            <RadioButton x:Name="AboutNav" GroupName="Navigation" Content="关于" Style="{StaticResource NavRadio}" Tag="about" Checked="Navigation_OnChecked" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="272" /></Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" FocusVisualStyle="{x:Null}" KeyboardNavigation.IsTabStop="False">
                                <Grid>
                                    <StackPanel x:Name="ScreenPanel">
                                        <Border Style="{StaticResource SectionCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="当前显示方案" FontSize="12" Foreground="{StaticResource SecondaryText}" />
                                                    <TextBlock x:Name="CurrentThemeNameText" Text="电脑状态" FontSize="22" FontWeight="SemiBold" Margin="0,9,0,0" />
                                                    <TextBlock x:Name="CurrentThemeDescription" Text="显示 CPU、内存与网络状态" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,9,0,0" />
                                                </StackPanel>
                                                <Button x:Name="SelectImageButton" Grid.Column="1" Content="选择图片" Style="{StaticResource SecondaryButton}" Click="ChooseImageButton_OnClick" Visibility="Collapsed" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SectionCard}">
                                            <StackPanel>
                                                <TextBlock Text="画面内容" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock x:Name="CurrentThemeDetailsText" Text="CPU 使用率、内存占用、实时下载和上传速率。" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,9,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel x:Name="ContextDataPanel">
                                        <Border x:Name="SystemDataCard" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="电脑状态" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="由 Windows 原生接口采集，不需要后台服务。" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,7,0,14" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="CpuValueText" Text="CPU —" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="MemoryValueText" Grid.Column="1" Text="内存 —" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="DownloadValueText" Grid.Column="2" Text="下载 —" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="UploadValueText" Grid.Column="3" Text="上传 —" FontWeight="SemiBold" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="MusicDataCard" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="Windows 媒体会话" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="读取当前媒体封面、曲名、歌手与播放进度。" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,7,0,14" />
                                                <TextBlock x:Name="MusicSourceText" Text="当前没有可用的 Windows 媒体会话" FontSize="12" Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="AiQuotaDataCard" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Xiaomi MiMo Token Plan (Beta)" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="AiSourceStatusText" Grid.Column="1" Text="尚未连接"
                                                               FontSize="11" Foreground="{StaticResource SecondaryText}"
                                                               VerticalAlignment="Center" Margin="16,0,0,0" />
                                                </Grid>
                                                <TextBlock Text="China · 读取订阅套餐的真实 Credits，用量信息仅保存在本机。"
                                                           FontSize="12" Foreground="{StaticResource SecondaryText}"
                                                           Margin="0,7,0,16" TextWrapping="Wrap" />

                                                <Border Style="{StaticResource InlineSurface}" Padding="16,12" Margin="0,0,0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="320" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="屏幕显示名称" FontSize="13" FontWeight="SemiBold" />
                                                            <TextBlock Text="建议不超过 12 个字符" FontSize="11"
                                                                       Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <TextBox x:Name="AiDisplayNameTextBox" Grid.Column="1" Text="MiMo" MaxLength="18"
                                                                 VerticalAlignment="Center" TextChanged="SettingTextBox_OnTextChanged" />
                                                    </Grid>
                                                </Border>

                                                <Border Style="{StaticResource InlineSurface}" Padding="16">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.05*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="1*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="1.1*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="剩余额度" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                                                                <TextBlock x:Name="MiMoRemainingValueText" Text="—" FontSize="24"
                                                                           FontWeight="SemiBold" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Width="1" Background="{StaticResource Stroke.Default}" Margin="18,2" />
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="已使用 / 总额" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                                                                <TextBlock x:Name="MiMoCreditsValueText" Text="—" FontSize="15"
                                                                           FontWeight="SemiBold" Margin="0,6,0,0" />
                                                            </StackPanel>
                                                            <Border Grid.Column="3" Width="1" Background="{StaticResource Stroke.Default}" Margin="18,2" />
                                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                                <TextBlock Text="本期截止" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                                                                <TextBlock x:Name="MiMoExpiryValueText" Text="—" FontSize="15"
                                                                           FontWeight="SemiBold" Margin="0,6,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <ProgressBar x:Name="MiMoRemainingProgress" Height="4" Minimum="0" Maximum="100"
                                                                     Value="0" Margin="0,14,0,0" Foreground="{StaticResource AccentBrush}"
                                                                     Background="{StaticResource Surface.Pressed}" BorderThickness="0">
                                                            <ProgressBar.Template>
                                                                <ControlTemplate TargetType="ProgressBar">
                                                                    <Grid ClipToBounds="True">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                                                                        <Border x:Name="PART_Track" />
                                                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                                                                HorizontalAlignment="Left" CornerRadius="2" />
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </ProgressBar.Template>
                                                        </ProgressBar>
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                                    <Button Content="登录小米控制台" MinWidth="138" Click="MiMoLoginButton_OnClick" />
                                                    <Button Content="立即刷新" Style="{StaticResource SecondaryButton}"
                                                            MinWidth="104" Margin="8,0,0,0" Click="MiMoRefreshButton_OnClick" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="WeatherDataCard" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="天气" FontSize="16" FontWeight="SemiBold" />
                                                        <TextBlock Text="自动定位使用 Windows 位置服务；不可用时回退到手动城市。"
                                                                   FontSize="11" Foreground="{StaticResource SecondaryText}" Margin="0,7,0,0" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="WeatherAutomaticLocationCheckBox" Grid.Column="1" Content="自动定位"
                                                              VerticalAlignment="Center"
                                                              Checked="WeatherAutomaticLocationCheckBox_OnChanged"
                                                              Unchecked="WeatherAutomaticLocationCheckBox_OnChanged" />
                                                </Grid>
                                                <Grid Margin="0,14,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="手动城市" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBox x:Name="WeatherLocationTextBox" Grid.Column="1" Text="北京" MaxLength="40"
                                                             Height="44" VerticalContentAlignment="Center"
                                                             ToolTip="自动定位关闭或不可用时使用，例如：北京、上海、深圳"
                                                             TextChanged="SettingTextBox_OnTextChanged" />
                                                </Grid>
                                                <TextBlock Text="天气由 Open-Meteo 提供；自动定位城市名由 BigDataCloud 解析。"
                                                           FontSize="11" Foreground="{StaticResource SecondaryText}" Margin="0,12,0,0" />
                                                <TextBlock x:Name="WeatherSourceStatusText" Text="等待获取天气数据"
                                                           FontSize="11" Foreground="{StaticResource SecondaryText}" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="StockDataCard" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="股票 (Beta)" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="最多添加三项。代码示例：AAPL、0700.HK、600519.SS、000001.SZ、BTC-USD。数据可能延迟或不准确，不构成投资建议。"
                                                           FontSize="11" Foreground="{StaticResource SecondaryText}" Margin="0,7,0,14" TextWrapping="Wrap" />
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Text="行情代码" FontSize="10" Foreground="{StaticResource SecondaryText}" />
                                                    <TextBlock Grid.Column="3" Text="显示别名（可选）" FontSize="10" Foreground="{StaticResource SecondaryText}" />
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="1" FontSize="12" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                                    <TextBox x:Name="StockSymbol1TextBox" Grid.Column="1" MaxLength="24" ToolTip="行情代码" TextChanged="SettingTextBox_OnTextChanged" />
                                                    <TextBox x:Name="StockAlias1TextBox" Grid.Column="3" MaxLength="12" ToolTip="显示别名（可选）" TextChanged="SettingTextBox_OnTextChanged" />
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="2" FontSize="12" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                                    <TextBox x:Name="StockSymbol2TextBox" Grid.Column="1" MaxLength="24" ToolTip="行情代码" TextChanged="SettingTextBox_OnTextChanged" />
                                                    <TextBox x:Name="StockAlias2TextBox" Grid.Column="3" MaxLength="12" ToolTip="显示别名（可选）" TextChanged="SettingTextBox_OnTextChanged" />
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="3" FontSize="12" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                                    <TextBox x:Name="StockSymbol3TextBox" Grid.Column="1" MaxLength="24" ToolTip="行情代码" TextChanged="SettingTextBox_OnTextChanged" />
                                                    <TextBox x:Name="StockAlias3TextBox" Grid.Column="3" MaxLength="12" ToolTip="显示别名（可选）" TextChanged="SettingTextBox_OnTextChanged" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="涨跌颜色" FontSize="13" FontWeight="SemiBold" />
                                                        <TextBlock x:Name="StockSourceStatusText" Text="15 分钟缓存 · 行情仅供展示" FontSize="11" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <ComboBox x:Name="StockColorPreferenceComboBox" Grid.Column="1" Height="44" SelectionChanged="ThemeOptionComboBox_OnSelectionChanged">
                                                        <ComboBoxItem Content="红涨绿跌" Tag="RedGain" />
                                                        <ComboBoxItem Content="绿涨红跌" Tag="GreenGain" />
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="ThemePanel" Visibility="Collapsed">
                                        <Border x:Name="FontSettingsCard" Style="{StaticResource SectionCard}">
                                            <StackPanel>
                                                <TextBlock Text="屏幕字体" FontSize="16" FontWeight="SemiBold" />
                                                <Grid Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="154" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="FontFamilyComboBox" Height="44" SelectionChanged="FontFamilyComboBox_OnSelectionChanged">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="4,3">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="10" Foreground="{StaticResource SecondaryText}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Button Grid.Column="2" Content="打开字体文件夹" Height="44" Style="{StaticResource SecondaryButton}" Click="OpenFontsFolderButton_OnClick" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Height="{Binding ActualHeight, ElementName=FontSettingsCard}" Style="{StaticResource SectionCard}">
                                                <StackPanel>
                                                    <TextBlock Text="主题强调色" FontSize="16" FontWeight="SemiBold" />
                                                    <Grid Margin="0,16,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="88" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border x:Name="AccentColorPreview" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Center" Background="#4DE2AE" BorderBrush="{StaticResource Stroke.Default}" BorderThickness="1" />
                                                        <TextBox x:Name="AccentColorTextBox" Grid.Column="2" Text="#4DE2AE" Height="44" Padding="8,0" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="AccentColorTextBox_OnTextChanged" />
                                                        <Button Grid.Column="4" Content="选择颜色" Height="44" Style="{StaticResource SecondaryButton}" Click="ChooseAccentColorButton_OnClick" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2" Height="{Binding ActualHeight, ElementName=FontSettingsCard}" Style="{StaticResource SectionCard}">
                                                <StackPanel>
                                                    <TextBlock Text="图片时间位置" FontSize="16" FontWeight="SemiBold" />
                                                    <ComboBox x:Name="ImageTimePlacementComboBox" Margin="0,16,0,0" Height="44" SelectionChanged="ThemeOptionComboBox_OnSelectionChanged">
                                                        <ComboBoxItem Content="显示在上方" Tag="Top" />
                                                        <ComboBoxItem Content="显示在下方" Tag="Bottom" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Border>
                                        </Grid>                                        
                                    </StackPanel>


                                    <StackPanel x:Name="AutomationPanel" Visibility="Collapsed">
                                        <Border Style="{StaticResource SectionCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="定时推送" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="动态方案按设定间隔推送；图片方案仅在导入后自动推送一次。" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,7,0,0" /></StackPanel><CheckBox x:Name="AutoPushCheckBox" Grid.Column="1" VerticalAlignment="Center" Content="启用" Checked="SettingToggle_OnChanged" Unchecked="SettingToggle_OnChanged" /></Grid></Border>
                                        <Border Style="{StaticResource SectionCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="刷新间隔" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="可设置为 1–30 秒中的任意整数。" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,7,0,0" /></StackPanel><Slider x:Name="RefreshIntervalSlider" Grid.Column="1" Minimum="1" Maximum="30" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="RefreshIntervalSlider_OnValueChanged" /><Border Grid.Column="3" Style="{StaticResource InlineSurface}" Height="36" VerticalAlignment="Center"><TextBlock x:Name="RefreshIntervalValueText" Text="5 秒" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
                                        <Border x:Name="AutoMusicCard" Style="{StaticResource SectionCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="播放音乐时自动切换" FontSize="15" FontWeight="SemiBold" />
                                                    <TextBlock Text="检测到活动媒体会话后临时显示默认音乐页面。" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,7,0,0" />
                                                </StackPanel>
                                                <CheckBox x:Name="AutoMusicCheckBox" Grid.Column="1" VerticalAlignment="Center" Content="启用" Checked="SettingToggle_OnChanged" Unchecked="SettingToggle_OnChanged" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SectionCard}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="媒体主题自动切换" FontSize="15" FontWeight="SemiBold" />
                                                        <TextBlock Text="播放与停止时分别切换到指定主题。" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,7,0,0" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="MediaThemeAutomationCheckBox" Grid.Column="1" VerticalAlignment="Center" Content="启用" Checked="SettingToggle_OnChanged" Unchecked="SettingToggle_OnChanged" />
                                                </Grid>
                                                <Grid Margin="0,18,0,0" IsEnabled="{Binding IsChecked, ElementName=MediaThemeAutomationCheckBox}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="无媒体播放时" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,8" />
                                                        <ComboBox x:Name="MediaIdleThemeComboBox" Height="44" SelectionChanged="MediaAutomationComboBox_OnSelectionChanged" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="检测到播放时" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,8" />
                                                        <ComboBox x:Name="MediaPlayingThemeComboBox" Height="44" SelectionChanged="MediaAutomationComboBox_OnSelectionChanged" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                                        <Border Style="{StaticResource SectionCard}" Padding="16">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="设备地址" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBox x:Name="EndpointTextBox" Visibility="Collapsed"
                                                         TextChanged="SettingTextBox_OnTextChanged" />
                                                <Border x:Name="SettingsIpAddressHost" Grid.Column="1" Height="50" Background="White"
                                                        BorderBrush="{StaticResource Stroke.Default}" BorderThickness="1" CornerRadius="14"
                                                        ToolTip="仅填写设备 IP，例如 192.168.1.100">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                        <TextBox x:Name="EndpointIpPart1" Tag="0" MaxLength="3" Height="48" Background="Transparent" BorderThickness="0" TextAlignment="Center" VerticalContentAlignment="Center" Padding="6,0" FontSize="17" PreviewTextInput="EndpointIpPart_OnPreviewTextInput" TextChanged="EndpointIpPart_OnTextChanged" PreviewKeyDown="EndpointIpPart_OnPreviewKeyDown" DataObject.Pasting="EndpointIpPart_OnPasting" />
                                                        <Border Grid.Column="1" Width="1" Height="24" Background="{StaticResource HairlineBrush}" VerticalAlignment="Center" />
                                                        <TextBox x:Name="EndpointIpPart2" Grid.Column="2" Tag="1" MaxLength="3" Height="48" Background="Transparent" BorderThickness="0" TextAlignment="Center" VerticalContentAlignment="Center" Padding="6,0" FontSize="17" PreviewTextInput="EndpointIpPart_OnPreviewTextInput" TextChanged="EndpointIpPart_OnTextChanged" PreviewKeyDown="EndpointIpPart_OnPreviewKeyDown" DataObject.Pasting="EndpointIpPart_OnPasting" />
                                                        <Border Grid.Column="3" Width="1" Height="24" Background="{StaticResource HairlineBrush}" VerticalAlignment="Center" />
                                                        <TextBox x:Name="EndpointIpPart3" Grid.Column="4" Tag="2" MaxLength="3" Height="48" Background="Transparent" BorderThickness="0" TextAlignment="Center" VerticalContentAlignment="Center" Padding="6,0" FontSize="17" PreviewTextInput="EndpointIpPart_OnPreviewTextInput" TextChanged="EndpointIpPart_OnTextChanged" PreviewKeyDown="EndpointIpPart_OnPreviewKeyDown" DataObject.Pasting="EndpointIpPart_OnPasting" />
                                                        <Border Grid.Column="5" Width="1" Height="24" Background="{StaticResource HairlineBrush}" VerticalAlignment="Center" />
                                                        <TextBox x:Name="EndpointIpPart4" Grid.Column="6" Tag="3" MaxLength="3" Height="48" Background="Transparent" BorderThickness="0" TextAlignment="Center" VerticalContentAlignment="Center" Padding="6,0" FontSize="17" PreviewTextInput="EndpointIpPart_OnPreviewTextInput" TextChanged="EndpointIpPart_OnTextChanged" PreviewKeyDown="EndpointIpPart_OnPreviewKeyDown" DataObject.Pasting="EndpointIpPart_OnPasting" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SectionCard}" Padding="16">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="内容安全区" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border x:Name="SafeAreaInputHost" Grid.Column="1" Height="50" Background="White"
                                                        BorderBrush="{StaticResource Stroke.Default}" BorderThickness="1" CornerRadius="14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="左" FontSize="11" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            <TextBox x:Name="SafeLeftTextBox" Grid.Column="1" Text="10" Height="48" Background="Transparent" BorderThickness="0" Padding="6,0" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="SettingTextBox_OnTextChanged" />
                                                        </Grid>
                                                        <Border Grid.Column="1" Width="1" Height="24" Background="{StaticResource HairlineBrush}" VerticalAlignment="Center" />
                                                        <Grid Grid.Column="2">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="上" FontSize="11" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            <TextBox x:Name="SafeTopTextBox" Grid.Column="1" Text="52" Height="48" Background="Transparent" BorderThickness="0" Padding="6,0" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="SettingTextBox_OnTextChanged" />
                                                        </Grid>
                                                        <Border Grid.Column="3" Width="1" Height="24" Background="{StaticResource HairlineBrush}" VerticalAlignment="Center" />
                                                        <Grid Grid.Column="4">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="右" FontSize="11" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            <TextBox x:Name="SafeRightTextBox" Grid.Column="1" Text="10" Height="48" Background="Transparent" BorderThickness="0" Padding="6,0" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="SettingTextBox_OnTextChanged" />
                                                        </Grid>
                                                        <Border Grid.Column="5" Width="1" Height="24" Background="{StaticResource HairlineBrush}" VerticalAlignment="Center" />
                                                        <Grid Grid.Column="6">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="下" FontSize="11" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            <TextBox x:Name="SafeBottomTextBox" Grid.Column="1" Text="12" Height="48" Background="Transparent" BorderThickness="0" Padding="6,0" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="SettingTextBox_OnTextChanged" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SectionCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="最小化到系统托盘" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" /><CheckBox x:Name="MinimizeToTrayCheckBox" Grid.Column="1" VerticalAlignment="Center" Content="启用" Checked="SettingToggle_OnChanged" Unchecked="SettingToggle_OnChanged" /></Grid></Border>
                                        <Border Style="{StaticResource SectionCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="关闭后最小化" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" /><CheckBox x:Name="CloseToTrayCheckBox" Grid.Column="1" VerticalAlignment="Center" Content="启用" Checked="SettingToggle_OnChanged" Unchecked="SettingToggle_OnChanged" /></Grid></Border>
                                        <Border Style="{StaticResource SectionCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="开机自启动" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" /><CheckBox x:Name="LaunchAtStartupCheckBox" Grid.Column="1" VerticalAlignment="Center" Content="启用" Checked="SettingToggle_OnChanged" Unchecked="SettingToggle_OnChanged" /></Grid></Border>
                                        <Border Style="{StaticResource SectionCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="启动后保持最小化" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" /><CheckBox x:Name="StartMinimizedCheckBox" Grid.Column="1" VerticalAlignment="Center" Content="启用" Checked="SettingToggle_OnChanged" Unchecked="SettingToggle_OnChanged" /></Grid></Border>
                                    </StackPanel>
                                    <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                                        <Border Style="{StaticResource SectionCard}">
                                            <StackPanel>
                                                <TextBlock Text="关于" FontSize="22" FontWeight="SemiBold" />
                                                <TextBlock Text="Keyboard Screen Studio 源代码采用 MIT License。第三方组件与数据服务仍遵循各自条款；应用图标与托盘图标采用单独的视觉资产许可。完整说明随程序提供。" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,9,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SectionCard}">
                                            <StackPanel>
                                                <TextBlock Text="开源组件" FontSize="15" FontWeight="SemiBold" />
                                                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="2.2*" /></Grid.ColumnDefinitions><TextBlock Text=".NET 8 自包含运行时" FontSize="13" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text=".NET Library License" FontSize="12" Foreground="{StaticResource SecondaryText}" /><TextBlock Grid.Column="2" Text="Copyright © Microsoft Corporation" FontSize="12" Foreground="{StaticResource SecondaryText}" /></Grid>
                                                <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,13" />
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="2.2*" /></Grid.ColumnDefinitions><TextBlock Text="Microsoft Edge WebView2 SDK" FontSize="13" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="WebView2 SDK License" FontSize="12" Foreground="{StaticResource SecondaryText}" /><TextBlock Grid.Column="2" Text="Copyright © Microsoft Corporation" FontSize="12" Foreground="{StaticResource SecondaryText}" /></Grid>
                                                <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,13" />
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="2.2*" /></Grid.ColumnDefinitions><TextBlock Text="Doto" FontSize="13" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="SIL OFL 1.1" FontSize="12" Foreground="{StaticResource SecondaryText}" /><TextBlock Grid.Column="2" Text="Copyright © 2024 The Doto Project Authors" FontSize="12" Foreground="{StaticResource SecondaryText}" /></Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="数据来源与声明" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="天气数据由 Open-Meteo 提供（CC BY 4.0），自动定位城市名由 BigDataCloud 解析。本项目为非商业个人开源项目，使用 Open-Meteo 免费非商业接口；商业再使用者需自行取得适用许可。Yahoo Finance 行情与 Xiaomi MiMo 用量均为非官方实验性集成，可能延迟、不准确或失效，不构成投资建议。Keyboard Screen Studio 与 Linx68 品牌、设备制造商及上述平台不存在隶属、授权、认可或赞助关系。应用与托盘图标为 AI 辅助创作的原创视觉资产，版权归 ZCat95 所有，详见 ASSET_LICENSE.md。" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,9,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                                        <StackPanel Margin="0,14,0,6" HorizontalAlignment="Center">
                                            <TextBlock Text="Keyboard Screen Studio 1.0" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,5,0,0" HorizontalAlignment="Center"><Run Text="by " /><Hyperlink Click="ZCat95Link_OnClick" Foreground="{StaticResource PrimaryText}" TextDecorations="Underline" Cursor="Hand">ZCat95</Hyperlink></TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <Border Grid.Column="2" Style="{StaticResource PreviewCard}" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="预览" FontSize="16" FontWeight="SemiBold" />
                                        
                                    </StackPanel>
                                    <local:DevicePreviewControl x:Name="DevicePreview" Grid.Row="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
